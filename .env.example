# Copy this file to `.env` and paste your TMDB "API Read Access Token"
# (themoviedb.org > Settings > API). The `.env` file is gitignored.
#
# Only `npm run sync` reads it, at build time. The name has no VITE_ prefix on
# purpose: Vite can only put VITE_ variables into the published JavaScript.
TMDB_READ_TOKEN=
