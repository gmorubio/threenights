{
  "name": "threenights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-tmdb.ts --soft",
    "dev": "vite",
    "sync": "node scripts/sync-tmdb.ts",
    "validate": "node scripts/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run validate && npm run typecheck && npm run sync",
    "build": "vite build",
    "postbuild": "npm run check-dist",
    "check-dist": "node scripts/check-dist.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
